---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "每天整理全国时政、申论精读与政策解读，来源均为官方原文。",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="top" id="top">
      <a class="logo" href="/">
        <img class="logo-img" src="/logo.png" alt="每日时政" />
      </a>
      <div class="top-in">
        <nav class="nav" id="nav">
          <a href="/">首页</a>
          <a href="/search/">搜索</a>
          <a href="/favorites/">收藏</a>
          <a href="/practice/">每日一练</a>
          <span class="nav-auth" id="kg-auth"><a href="/login/">登录</a></span>
        </nav>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="菜单">☰</button>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="foot">时政小助手 · 内容来自官方原文，请以原文为准</footer>
    <script>
      import { clearToken, tokenUsername } from "../lib/auth";

      const box = document.getElementById("kg-auth");
      if (box) {
        const name = tokenUsername();
        if (name) {
          box.textContent = "";
          const link = document.createElement("a");
          link.href = "/profile/";
          link.textContent = name;
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "nav-logout";
          btn.textContent = "退出";
          btn.addEventListener("click", () => {
            clearToken();
            location.reload();
          });
          box.append(link, btn);
        }
      }

      // 下滑收起导航，悬停展开
      const topEl = document.getElementById("top");
      if (topEl) {
        const onScroll = () => topEl.classList.toggle("collapsed", window.scrollY > 140);
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
