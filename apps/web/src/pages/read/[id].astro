---
import Base from "../../layouts/Base.astro";
import { listArticles } from "../../lib/content";

export function getStaticPaths() {
  return listArticles().map((a) => ({ params: { id: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const aiAnnotations = article.aiStatus === "ok" ? article.aiAnnotations ?? [] : [];
---
<Base title={`${article.title} · 时政小助手`}>
  <div class="reading-head">
    <p class="item-summary">{article.source} · {article.date} · <a href={article.url} target="_blank" rel="noopener">查看原文 ↗</a></p>
    <h1 class="reading-title">{article.title}</h1>
    <div class="read-actions">
      <button type="button" class="read-fav" id="read-fav" data-title={article.title} data-url={article.url}>☆ 收藏本文</button>
      <div class="reader-mode" role="group" aria-label="阅读模式">
        <button type="button" id="mode-original" class="on" aria-pressed="true">原文模式</button>
        <button type="button" id="mode-ai" aria-pressed="false" disabled>AI 标注模式</button>
      </div>
      <div class="read-toolbar">
        <button type="button" id="font-minus" title="缩小字体">A−</button>
        <button type="button" id="font-plus" title="放大字体">A＋</button>
        <select id="font-select" title="字体">
          <option value="default">默认</option>
          <option value="serif">宋体</option>
          <option value="kai">楷体</option>
          <option value="hei">黑体</option>
          <option value="shoujin">瘦金简体</option>
        </select>
        <button type="button" id="immersive" title="沉浸式阅读">沉浸</button>
        <button type="button" id="fullscreen" title="全屏">⛶</button>
      </div>
    </div>
  </div>

  <p class="ai-mode-status" id="ai-mode-status" hidden></p>
  <article class="reading" id="article" data-id={article.id} data-ai-status={article.aiStatus ?? "legacy"}>
    {article.keySentences?.length > 0 && <blockquote>{article.keySentences[0]}</blockquote>}
    {article.paragraphs.map((p) => <p class="reading-para">{p}</p>)}
  </article>
  <script type="application/json" id="ai-annotations" set:html={JSON.stringify(aiAnnotations).replace(/</g, "\\u003c")}></script>

  <div id="hl-toolbar" class="hl-toolbar" hidden>
    <button type="button" data-act="green">荧光笔</button>
    <button type="button" data-act="explain">AI 解释</button>
    <button type="button" data-act="underline">下划线</button>
    <button type="button" data-act="favorite">收藏</button>
    <button type="button" data-act="note">注释</button>
  </div>
</Base>

<script>
  import { api } from "../../lib/api";
  import { applyStyle, removeRange, removeStyle, type Span } from "../../lib/highlights";
  import { readerSegmentsToHtml, validAiAnnotations, buildReaderSegments } from "../../lib/reader-annotations";
  import type { AiAnnotation, Highlight, HighlightStyle } from "@kaogong/contracts";

  const articleEl = document.getElementById("article") as HTMLElement;
  const toolbar = document.getElementById("hl-toolbar") as HTMLElement;
  const articleId = articleEl.dataset.id || "";
  const paraEls = Array.from(articleEl.querySelectorAll<HTMLElement>(".reading-para"));

  // 文章各段落原文（从初始 DOM 读取，重渲染前捕获一次），是偏移计算与重渲染的唯一事实源。
  const paraText: string[] = paraEls.map((el) => el.textContent ?? "");
  const aiStatus = articleEl.dataset.aiStatus;
  const annotationData = document.getElementById("ai-annotations")?.textContent ?? "[]";
  let aiAnnotations: AiAnnotation[] = [];
  try {
    aiAnnotations = JSON.parse(annotationData) as AiAnnotation[];
  } catch {
    aiAnnotations = [];
  }
  const validAnnotations = aiAnnotations.filter((annotation) => {
    const text = paraText[annotation.paragraphIndex];
    return text !== undefined && validAiAnnotations(text, [annotation]).length === 1;
  });
  let aiMode = false;

  const originalModeButton = document.getElementById("mode-original") as HTMLButtonElement;
  const aiModeButton = document.getElementById("mode-ai") as HTMLButtonElement;
  const aiModeStatus = document.getElementById("ai-mode-status") as HTMLElement;
  const aiAvailable = aiStatus === "ok" && validAnnotations.length > 0;
  aiModeButton.disabled = !aiAvailable;
  if (!aiAvailable) {
    aiModeStatus.hidden = false;
    aiModeStatus.textContent = aiStatus === "error"
      ? "AI 标注生成失败，当前仍可阅读完整原文。"
      : "这篇文章暂时没有 AI 标注，当前显示完整原文。";
  }

  // ===== 字体 / 沉浸 / 全屏 =====
  const FONT_SIZE_KEY = "kaogong.read.fontsize";
  const FONT_NAME_KEY = "kaogong.read.font";
  const FONTS: Record<string, string> = {
    default: "var(--font)",
    serif: "var(--font-serif)",
    kai: '"KaiTi", "楷体", "STKaiti", serif',
    hei: '"SimHei", "黑体", "Microsoft YaHei", sans-serif',
    shoujin: '"瘦金简体", "汉仪瘦金书简", "ShouJinTi", "STKaiti", serif',
  };

  let fontSize = Number(localStorage.getItem(FONT_SIZE_KEY)) || 17;
  function setFontSize(n: number) {
    fontSize = Math.min(26, Math.max(13, n));
    articleEl.style.fontSize = `${fontSize}px`;
    localStorage.setItem(FONT_SIZE_KEY, String(fontSize));
  }
  setFontSize(fontSize);

  function setFont(name: string) {
    articleEl.style.fontFamily = FONTS[name] || FONTS.default!;
    localStorage.setItem(FONT_NAME_KEY, name);
  }
  const savedFont = localStorage.getItem(FONT_NAME_KEY);
  if (savedFont) {
    (document.getElementById("font-select") as HTMLSelectElement).value = savedFont;
    setFont(savedFont);
  }

  document.getElementById("font-minus")!.addEventListener("click", () => setFontSize(fontSize - 1));
  document.getElementById("font-plus")!.addEventListener("click", () => setFontSize(fontSize + 1));
  document.getElementById("font-select")!.addEventListener("change", (e) => setFont((e.target as HTMLSelectElement).value));
  document.getElementById("immersive")!.addEventListener("click", (e) => {
    document.body.classList.toggle("immersive");
    (e.target as HTMLButtonElement).textContent = document.body.classList.contains("immersive") ? "退出" : "沉浸";
  });
  document.getElementById("fullscreen")!.addEventListener("click", () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen();
  });

  const favBtn = document.getElementById("read-fav") as HTMLButtonElement;
  favBtn.addEventListener("click", async () => {
    const url = favBtn.dataset.url || "";
    const title = favBtn.dataset.title || "";
    const env = await api.addFavorite({ url, title });
    favBtn.textContent = env.ok ? "★ 已收藏" : "☆ 收藏失败";
    favBtn.disabled = env.ok;
  });

  // ===== 划线：以段落内偏移为源，数据驱动重渲染 =====
  let records: Highlight[] = [];
  const paragraphVersions: Record<number, number> = {};
  let highlightsLoaded = false;
  // 保存期间禁用同段重复操作，不再静默丢弃操作。
  const reconcileBusy: Record<number, boolean> = {};

  function spansFor(index: number): Span[] {
    return records
      .filter((r) => r.paragraphIndex === index)
      .map((r) => ({ start: r.start, end: r.end, styles: [...r.styles].sort() }))
      .sort((a, b) => a.start - b.start || a.end - b.end);
  }

  function renderParagraph(index: number) {
    const para = paraEls[index];
    if (!para) return;
    const text = paraText[index] ?? para.textContent ?? "";
    const annotations = aiMode ? validAnnotations.filter((annotation) => annotation.paragraphIndex === index) : [];
    para.innerHTML = readerSegmentsToHtml(buildReaderSegments(text, spansFor(index), annotations));
  }

  function renderAll() {
    paraEls.forEach((_, i) => renderParagraph(i));
  }

  function setAiMode(enabled: boolean) {
    aiMode = enabled && aiAvailable;
    originalModeButton.classList.toggle("on", !aiMode);
    aiModeButton.classList.toggle("on", aiMode);
    originalModeButton.setAttribute("aria-pressed", String(!aiMode));
    aiModeButton.setAttribute("aria-pressed", String(aiMode));
    articleEl.dataset.mode = aiMode ? "ai" : "original";
    renderAll();
  }
  originalModeButton.addEventListener("click", () => setAiMode(false));
  aiModeButton.addEventListener("click", () => setAiMode(true));
  setAiMode(false);

  async function loadHighlights() {
    const env = await api.listHighlightParagraphs(articleId);
    if (!env.ok || !env.data) {
      toast("划线加载失败，请刷新后重试");
      return false;
    }
    records = env.data.flatMap((paragraph) => {
      paragraphVersions[paragraph.paragraphIndex] = paragraph.version;
      return paragraph.highlights.filter((record) => {
        const text = paraText[record.paragraphIndex];
        return text !== undefined && text.slice(record.start, record.end) === record.text;
      });
    });
    renderAll();
    highlightsLoaded = true;
    return true;
  }

  async function reconcileParagraph(index: number, spans: Span[], noteOverrides: Record<string, string> = {}) {
    if (!highlightsLoaded) {
      toast("划线仍在加载，请稍后重试");
      return false;
    }
    if (reconcileBusy[index]) {
      toast("正在保存上一项操作");
      return false;
    }
    reconcileBusy[index] = true;
    try {
      const old = records.filter((r) => r.paragraphIndex === index);
      const notes = new Map<string, string>();
      for (const r of old) notes.set(`${r.start}:${r.end}`, r.note);
      for (const [k, v] of Object.entries(noteOverrides)) notes.set(k, v);

      const body = spans.map((span) => {
        const inheritedNote = old.find((record) =>
          record.note && record.start < span.end && span.start < record.end,
        )?.note ?? "";
        const noteKey = `${span.start}:${span.end}`;
        return {
          text: (paraText[index] ?? "").slice(span.start, span.end),
          note: Object.prototype.hasOwnProperty.call(noteOverrides, noteKey)
            ? noteOverrides[noteKey]!
            : notes.get(noteKey) ?? inheritedNote,
          styles: span.styles,
          start: span.start,
          end: span.end,
        };
      });
      const res = await api.replaceHighlightParagraph({
        articleId,
        paragraphIndex: index,
        baseVersion: paragraphVersions[index] ?? 0,
        spans: body,
      });
      if (!res.ok || !res.data) {
        toast(res.error?.code === "HIGHLIGHT_CONFLICT" ? "划线已在其他页面更新，正在重新加载" : "划线保存失败，原数据未变");
        await loadHighlights();
        return false;
      }
      paragraphVersions[index] = res.data.version;
      records = records.filter((r) => r.paragraphIndex !== index).concat(res.data.highlights);
      renderParagraph(index);
      return true;
    } finally {
      reconcileBusy[index] = false;
    }
  }

  // 选区 → 段落内字符偏移
  function pointOffset(para: HTMLElement, node: Node, offset: number): number | null {
    const walker = document.createTreeWalker(para, NodeFilter.SHOW_TEXT);
    let total = 0;
    let cur: Node | null;
    while ((cur = walker.nextNode())) {
      if (cur === node) return total + offset;
      total += cur.textContent?.length ?? 0;
    }
    return null;
  }

  interface SelectionOffsets {
    paragraphIndex: number;
    start: number;
    end: number;
    text: string;
    rect: DOMRect;
  }

  let current: SelectionOffsets | null = null;

  function selectionToOffsets(): SelectionOffsets | null {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return null;
    const range = sel.getRangeAt(0);
    const startEl = range.startContainer.nodeType === Node.TEXT_NODE
      ? (range.startContainer as Text).parentElement
      : (range.startContainer as Element);
    const para = startEl?.closest(".reading-para") as HTMLElement | null;
    if (!para || !para.contains(range.endContainer)) return null;
    const index = paraEls.indexOf(para);
    if (index < 0) return null;
    const start = pointOffset(para, range.startContainer, range.startOffset);
    const end = pointOffset(para, range.endContainer, range.endOffset);
    if (start === null || end === null || start >= end) return null;
    return {
      paragraphIndex: index,
      start,
      end,
      text: (paraText[index] ?? "").slice(start, end),
      rect: range.getBoundingClientRect(),
    };
  }

  function placeFloating(el: HTMLElement, rect: DOMRect) {
    const viewport = window.visualViewport;
    const leftEdge = viewport?.offsetLeft ?? 0;
    const topEdge = viewport?.offsetTop ?? 0;
    const width = viewport?.width ?? window.innerWidth;
    const height = viewport?.height ?? window.innerHeight;
    const margin = 8;
    if (width <= 600) {
      el.style.left = `${leftEdge + margin}px`;
      el.style.right = `${margin}px`;
      el.style.top = "auto";
      el.style.bottom = "calc(8px + env(safe-area-inset-bottom))";
      return;
    }
    el.style.right = "auto";
    el.style.bottom = "auto";
    const preferredLeft = rect.left + rect.width / 2 - el.offsetWidth / 2;
    el.style.left = `${Math.max(leftEdge + margin, Math.min(preferredLeft, leftEdge + width - el.offsetWidth - margin))}px`;
    const below = rect.bottom + margin;
    const top = below + el.offsetHeight <= topEdge + height - margin
      ? below
      : Math.max(topEdge + margin, rect.top - el.offsetHeight - margin);
    el.style.top = `${top}px`;
  }

  function showSelectionToolbar() {
    if (!highlightsLoaded) return;
    const off = selectionToOffsets();
    if (!off || off.text.trim().length < 2 || off.text.trim().length > 300) {
      hide();
      return;
    }
    current = off;
    toolbar.hidden = false;
    placeFloating(toolbar, off.rect);
  }

  const hide = () => {
    toolbar.hidden = true;
    current = null;
    window.getSelection()?.removeAllRanges();
  };

  document.addEventListener("pointerup", (e) => {
    if (toolbar.contains(e.target as Node)) return;
    setTimeout(showSelectionToolbar, 0);
  });

  let selectionTimer = 0;
  document.addEventListener("selectionchange", () => {
    if (!toolbar.hidden || !delBox.hidden) return;
    window.clearTimeout(selectionTimer);
    selectionTimer = window.setTimeout(showSelectionToolbar, 120);
  });

  document.addEventListener("pointerdown", (e) => {
    const t = e.target as HTMLElement;
    if (!toolbar.hidden && !toolbar.contains(t) && !t.closest("mark[data-user-highlight]")) {
      hide();
    }
  });

  let explainBox: HTMLDivElement | null = null;
  async function explain(text: string, rect: DOMRect) {
    if (!explainBox) {
      explainBox = document.createElement("div");
      explainBox.className = "explain-pop";
      document.body.appendChild(explainBox);
      explainBox.addEventListener("click", () => {
        explainBox!.hidden = true;
      });
    }
    explainBox.textContent = "解释中…";
    explainBox.hidden = false;
    placeFloating(explainBox, rect);
    const env = await api.explain(text);
    explainBox.textContent = env.ok && env.data ? env.data.explanation : "解释失败";
  }

  function toast(msg: string) {
    const t = document.createElement("div");
    t.className = "toast";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 2000);
  }

  // 关键：mousedown 阻止按钮夺焦点（否则选区被清空）
  const preserveSelection = (e: Event) => {
    window.clearTimeout(selectionTimer);
    e.preventDefault();
    e.stopPropagation();
  };
  toolbar.addEventListener("pointerdown", preserveSelection);
  toolbar.addEventListener("mousedown", preserveSelection);

  toolbar.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    const selected = current;
    if (!btn || !selected) {
      toolbar.dataset.state = "missing-selection";
      toast("选区已失效，请重新选择文字");
      return;
    }
    toolbar.dataset.state = "saving";
    const act = btn.dataset.act as string;
    const { paragraphIndex, start, end, text, rect } = selected;
    let saved = true;
    if (act === "green" || act === "underline") {
      saved = await reconcileParagraph(paragraphIndex, applyStyle(spansFor(paragraphIndex), { start, end }, act as HighlightStyle));
    } else if (act === "explain") {
      saved = await reconcileParagraph(paragraphIndex, applyStyle(spansFor(paragraphIndex), { start, end }, "yellow"));
      if (saved) await explain(text, rect);
    } else if (act === "favorite") {
      const env = await api.addFavorite({ url: location.href, title: text });
      toast(env.ok ? "已收藏" : "收藏失败");
    } else if (act === "note") {
      const note = prompt("写注释：", "");
      if (note !== null) {
        saved = await reconcileParagraph(
          paragraphIndex,
          applyStyle(spansFor(paragraphIndex), { start, end }, "yellow"),
          { [`${start}:${end}`]: note },
        );
      }
    }
    toolbar.dataset.state = saved ? "saved" : "error";
    if (saved) hide();
  });

  // 点击已有高亮 → 取消该区间全部样式
  const delBox = document.createElement("div");
  delBox.className = "hl-del";
  delBox.hidden = true;
  document.body.appendChild(delBox);
  let delTarget: { paragraphIndex: number; start: number; end: number } | null = null;

  function markOffsets(para: HTMLElement, mark: HTMLElement): { start: number; end: number } | null {
    const walker = document.createTreeWalker(para, NodeFilter.SHOW_TEXT);
    let total = 0;
    let cur: Node | null;
    while ((cur = walker.nextNode())) {
      const len = cur.textContent?.length ?? 0;
      if (cur.parentElement === mark) return { start: total, end: total + len };
      total += len;
    }
    return null;
  }

  document.addEventListener("click", (e) => {
    const mark = (e.target as HTMLElement).closest("mark[data-user-highlight]") as HTMLElement | null;
    if (mark) {
      const para = mark.closest(".reading-para") as HTMLElement | null;
      if (!para) return;
      const index = paraEls.indexOf(para);
      const off = markOffsets(para, mark);
      if (index < 0 || !off) return;
      delTarget = { paragraphIndex: index, start: off.start, end: off.end };
      const rect = mark.getBoundingClientRect();
      const currentStyles = spansFor(index).find((span) => span.start <= off.start && off.end <= span.end)?.styles ?? [];
      delBox.replaceChildren();
      for (const style of currentStyles) {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.style = style;
        button.textContent = style === "underline" ? "移除下划线" : style === "green" ? "移除荧光笔" : "移除高亮";
        delBox.appendChild(button);
      }
      const note = records.find((record) => record.paragraphIndex === index && record.start <= off.start && off.end <= record.end)?.note ?? "";
      const noteButton = document.createElement("button");
      noteButton.type = "button";
      noteButton.dataset.note = "edit";
      noteButton.textContent = note ? "查看/编辑注释" : "添加注释";
      noteButton.title = note;
      delBox.appendChild(noteButton);
      const allButton = document.createElement("button");
      allButton.type = "button";
      allButton.dataset.all = "true";
      allButton.textContent = "移除全部";
      delBox.appendChild(allButton);
      delBox.hidden = false;
      placeFloating(delBox, rect);
    } else if (!(e.target as HTMLElement).closest(".hl-del")) {
      delBox.hidden = true;
    }
  });

  delBox.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    if (!btn || !delTarget) return;
    const { paragraphIndex, start, end } = delTarget;
    if (btn.dataset.note === "edit") {
      const note = prompt("编辑注释（清空即删除）：", btn.title);
      if (note === null) return;
      const saved = await reconcileParagraph(
        paragraphIndex,
        spansFor(paragraphIndex),
        { [`${start}:${end}`]: note },
      );
      if (saved) delBox.hidden = true;
      return;
    }
    const next = btn.dataset.all === "true"
      ? removeRange(spansFor(paragraphIndex), { start, end })
      : removeStyle(spansFor(paragraphIndex), { start, end }, btn.dataset.style as HighlightStyle);
    const saved = await reconcileParagraph(paragraphIndex, next);
    if (!saved) return;
    delTarget = null;
    delBox.hidden = true;
  });

  // 回填：拉取已有划线并重渲染（与新建走同一条渲染路径）
  void loadHighlights();
</script>
