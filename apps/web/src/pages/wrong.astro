---
import Base from "../layouts/Base.astro";
---
<Base title="错题本 · 时政小助手">
  <section class="card">
    <h2>错题本</h2>
    <p class="item-summary">复习答错的题目，掌握后点「掌握 ✓」移除。</p>
    <div id="wrong-list"><p class="item-summary">加载中…</p></div>
  </section>
</Base>

<script>
  import { api } from "../lib/api";
  import type { WrongQuestion } from "@kaogong/contracts";

  const esc = (s: unknown): string =>
    String(s ?? "").replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
      return map[c] ?? c;
    });
  const LETTERS = ["A", "B", "C", "D"];
  const list = document.getElementById("wrong-list")!;

  function render(items: WrongQuestion[]) {
    if (!items.length) {
      list.innerHTML = '<p class="item-summary">暂无错题，去做每日一练吧。</p>';
      return;
    }
    list.innerHTML = items.map((w) => {
      const opts = w.options.map((o, i) => {
        const cls = i === w.answer ? "wq-opt is-correct" : i === w.chosen ? "wq-opt is-wrong" : "wq-opt";
        return `<span class="${cls}">${LETTERS[i]}. ${esc(o)}</span>`;
      }).join("");
      return `
        <div class="wq-item" data-id="${esc(w.id)}">
          <div class="wq-head"><span class="wq-date">${esc(w.date)}</span><button type="button" class="wq-del">掌握 ✓</button></div>
          <p class="wq-q">${esc(w.question)}</p>
          <div class="wq-opts">${opts}</div>
          <p class="wq-analysis">解析：${esc(w.analysis)}</p>
        </div>`;
    }).join("");

    list.querySelectorAll<HTMLButtonElement>(".wq-del").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.closest<HTMLElement>(".wq-item")?.dataset.id || "";
        await api.deleteWrongQuestion(id);
        await load();
      });
    });
  }

  async function load() {
    const env = await api.listWrongQuestions();
    if (env.ok && env.data) render(env.data);
    else list.innerHTML = '<p class="item-summary">错题加载失败，请刷新重试。</p>';
  }

  load();
</script>
