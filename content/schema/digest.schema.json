{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaogong.local/schema/digest.schema.json",
  "title": "DailyDigest",
  "description": "一份每日日报（管道产出 → apps/web 消费）。权威契约：Python 侧据此校验产出。",
  "type": "object",
  "required": ["date", "title", "sections"],
  "properties": {
    "date": { "type": "string", "description": "YYYY-MM-DD" },
    "title": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "type": "string", "description": "栏目 slug，如 national / essay" },
        "title": { "type": "string", "description": "栏目名，如 全国时政要闻" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["title", "date", "sourceUrl"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "description": "短写 MM-DD" },
        "sourceUrl": { "type": "string", "description": "原文链接" },
        "summary": { "type": "string", "description": "摘要（政策解读/地区/南方时评等栏目有）" },
        "quotes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "金句摘录，可为空"
        }
      }
    }
  }
}
