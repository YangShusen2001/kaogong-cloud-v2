{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaogong.local/schema/article.schema.json",
  "title": "ClippedArticle",
  "description": "剪藏原文（对应原项目 data/原文/{date}/*.json）。权威契约：Python 侧据此校验产出。",
  "type": "object",
  "required": [
    "id", "date", "title", "source", "url",
    "pubDate", "fetchedAt", "status", "paragraphs", "keySentences"
  ],
  "properties": {
    "id": { "type": "string" },
    "date": { "type": "string", "description": "YYYY-MM-DD" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "url": { "type": "string" },
    "pubDate": { "type": "string", "description": "原文发布日期，可为空字符串" },
    "fetchedAt": { "type": "string" },
    "status": { "enum": ["ok", "error"] },
    "paragraphs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keySentences": {
      "type": "array",
      "items": { "type": "string" },
      "description": "金句摘录"
    }
  }
}
