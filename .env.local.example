# 本地审核服务（启动审核.bat）的环境变量示例。
# 复制本文件为 .env.local 并填入真实值（.env.local 已被 gitignore，不会提交）。

# DeepSeek：AI 概括 / 标注 / 每日一练 / 今日速览
DEEPSEEK_API_KEY=sk-...

# 前端静态站要烤进去的 Worker 域名（生产）
PUBLIC_API_BASE=https://api.meirishizheng.cn

# Cloudflare：本地「发布到 CF」部署 Pages 需要（Cloudflare Dashboard → 我的资料 → API Tokens）
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# 邀请码后台管理：审核服务转发到生产 Worker 的 /api/invite/admin/* 时用的鉴权密钥。
# 必须与 Worker 的 JOB_SECRET secret（wrangler secret put JOB_SECRET）完全一致。
JOB_SECRET=...
